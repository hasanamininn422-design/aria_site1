# Copy to .env.local. Set a real public origin only in the deployment environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://aria:aria@localhost:5432/aria_color
# Future milestone: S3-compatible object storage and session secret.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AUTH_SECRET=

# Generate a unique random secret (at least 32 bytes); never commit real secrets.
RATE_LIMIT_SECRET=
